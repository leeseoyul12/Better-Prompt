# OpenAI Responses API
BETTER_PROMPT_PROVIDER=openai
# Enable after the deployment's model spend limit is configured.
BETTER_PROMPT_PUBLIC_IMPROVE=false
# Comma-separated emails used when public improvements are disabled.
BETTER_PROMPT_ALLOWED_EMAILS=
BETTER_PROMPT_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
BETTER_PROMPT_MAX_PROMPT_LENGTH=2000
BETTER_PROMPT_SAVED_PROMPT_MAX_LENGTH=6000
BETTER_PROMPT_RATE_LIMIT_MAX_REQUESTS=10
BETTER_PROMPT_RATE_LIMIT_WINDOW_SECONDS=60
BETTER_PROMPT_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/better_prompt
# For encrypted SQLite, use sqlite+pysqlcipher:///./backend/better_prompt.encrypted.sqlite3
# and provide a random 64-character hexadecimal key through the host's secret environment.
# Keep this blank with the default PostgreSQL or plaintext development SQLite URL.
BETTER_PROMPT_SQLITE_ENCRYPTION_KEY=
BETTER_PROMPT_SESSION_DURATION_DAYS=14
BETTER_PROMPT_GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
# Automatic retries are off; code caps explicit opt-in retries at one.
OPENAI_RETRY_ATTEMPTS=0
OPENAI_MAX_OUTPUT_TOKENS=1024
